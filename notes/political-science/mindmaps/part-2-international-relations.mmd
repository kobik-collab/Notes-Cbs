%% title: International Relations
%% part: Part II · International Relations
%% order: 2
flowchart TB
  IR["International Relations: how states and other actors interact under anarchy"]:::core

  ANARCHY["Anarchy: no world government above states"]:::concept
  LEVELS["Levels of analysis: individual, state, system"]:::concept
  IR --> ANARCHY
  IR --> LEVELS

  subgraph REALISM["Realism (IR I)"]
    REAL["Realism: states seek power and survival"]:::real
    SELFHELP["Self help"]:::real
    SECDIL["Security dilemma"]:::real
    BOP["Balance of power"]:::real
    POLAR["Polarity: uni, bi, multipolar"]:::real
    REAL --> SELFHELP
    SELFHELP -->|breeds| SECDIL
    SECDIL -->|drives| BOP
    BOP -->|creates| POLAR
  end
  ANARCHY -->|forces self help, per| REAL

  subgraph LIBERALISM["Liberalism (IR II)"]
    LIB["Liberalism: cooperation is possible"]:::lib
    INST["Institutions and regimes"]:::lib
    COOP["Cooperation under anarchy"]:::lib
    KANT["Kantian triangle: democracy, trade, IGOs"]:::lib
    DEMPEACE["Democratic peace"]:::lib
    LIB --> INST
    INST -->|lower distrust and enable| COOP
    LIB --> KANT
    KANT -->|produces| DEMPEACE
  end
  ANARCHY -->|can be tamed, per| LIB
  REAL -->|clash over relative vs absolute gains| LIB

  subgraph CONSTRUCT["Constructivism (IR III)"]
    CON["Constructivism: ideas build reality"]:::con
    IDEAS["Identities, norms, culture"]:::con
    WENDT["Anarchy is what states make of it"]:::con
    CON --> IDEAS
    IDEAS -->|shape interests| WENDT
  end
  ANARCHY -->|has no fixed meaning, per| CON

  subgraph CRITICAL["Critical approaches (IR III)"]
    CRIT["Critical theory: expose power and hierarchy"]:::crit
    MARX["Marxism and world systems"]:::crit
    GENDER["Feminist and postcolonial IR"]:::crit
    CRIT --> MARX
    CRIT --> GENDER
  end
  CON -->|shares social lens with| CRIT

  subgraph SECURITY["International security (IR IV)"]
    SEC["Security: a contested concept"]:::sec
    REF["Referent object: whose security"]:::sec
    SECUR["Securitisation: a speech act"]:::sec
    WAR["Causes of war across levels"]:::sec
    SEC --> REF
    SEC -->|created by| SECUR
    SEC --> WAR
  end
  SELFHELP -->|realist reading of| SEC
  IDEAS -->|constructivist reading of| SEC
  LEVELS -->|used to explain| WAR

  subgraph FOREIGN["Foreign policymaking"]
    FPA["Foreign Policy Analysis: open the black box"]:::fp
    DOM["Domestic variables"]:::fp
    TWO["Two level games: Putnam"]:::fp
    FPA --> DOM
    DOM -->|meet the world via| TWO
  end
  REAL -->|treats state as a black box, unlike| FPA
  LEVELS -->|feeds| FPA

